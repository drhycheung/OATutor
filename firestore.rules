rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user learning progress — only the signed-in owner may read or write.
    match /users/{owner} {
      allow read, write: if request.auth != null && request.auth.uid == owner;
    }

    // Existing analytics/logging collections (see src/components/Firebase.js).
    // Authenticated users only, and never the per-user progress documents.
    match /{collection}/{doc} {
      allow read, write: if request.auth != null
        && collection != "users"
        && collection.matches("development_.*|problemSubmissions|problemStartLogs|feedbacks|siteLogs|focusStatus|chatHistory|chatSessions|mouseMovement");
    }

    // One level deeper (e.g. focusStatus/{doc}/partitions/{doc}).
    match /{collection}/{doc}/{sub}/{subdoc} {
      allow read, write: if request.auth != null
        && collection != "users"
        && collection.matches("development_.*|focusStatus");
    }
  }
}